# Server
PORT=5000

# Neon PostgreSQL connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Allowed frontend URL(s), comma-separated. Leave empty in local dev to allow all.
FRONTEND_URL=http://localhost:5173
