PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=digital_banking_system
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Cloud MySQL (e.g. Aiven) - set DB_SSL=true and paste the CA certificate
DB_SSL=false
DB_SSL_CA=

# Comma-separated list of allowed frontend URLs (leave empty to allow all)
CORS_ORIGIN=
